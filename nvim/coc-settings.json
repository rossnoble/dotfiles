{
  "$schema": "http://json-schema.org/draft-06/schema",
  "description": "Configuration file for coc.nvim",
  "additionalProperties": false,
  "http.proxySupport": "off",
  "signature.enabled": true,

  "tsserver.enable": true,
  // "tsserver.log": "verbose",
  "tsserver.formatOnType": true,
  "tsserver.autoFixOnSave": true,
  // "tsserver.tsdk": ".yarn/sdks/typescript/lib",

  "diagnostic.enabled": true,
  "diagnostic.refreshOnInsertMode": false,
  "diagnostic.refreshAfterSave": true,
  "diagnostic.checkCurrentLine": true,
  "diagnostic.enableMessage": "jump",

  "suggest.autoTrigger": "always", // always, none, trigger
  "suggest.disableMenu": false,
  "suggest.floatEnable": true,
  "suggest.timeout": 500,
  "suggest.minTriggerInputLength": 2,
  // Don't pre-select first suggestion
  "suggest.noselect": true,

  "workspace.bottomUpFiletypes": ["typescript"],
  "workspace.workspaceFolderCheckCwd": true,
  "workspace.ignoredFolders": [
    "$HOME",
    "/node_modules",
    "**/node_modules/**",
    "**/.git",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.yarn/cache",
    "**/target",
    "**/tmp"
  ],

  "coc.source.typescript.enable": true,
  "coc.preferences.hoverTarget": "float",
  "coc.preferences.messageLevel": "error",
  "coc.preferences.rootPatterns": ["tsconfig.json"],
  "coc.preferences.maxFileSize": "1MB",
  "coc.source.file.ignorePatterns": [
    "node_modules"
  ],
  "coc.source.buffer.ignoreGitignore": true,
  "coc.preferences.formatOnType": false,
  "coc.preferences.formatOnSaveFiletypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "html",
    "liquid",
    "handlebars",
    "astro",
    "css"
  ],

  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },

  "typescript.validate.enable": true,
  "typescript.suggest.enabled": true,
  "typescript.suggestionActions.enabled": true,
  "typescript.suggest.autoImports": true,
  "typescript.suggest.paths": true,
  "typescript.format.enabled": true,
  "typescript.workspaceSymbols.scope": ["currentProject"],
  "typescript.preferences.includePackageJsonAutoImports": "off",
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.disableAutomaticTypeAcquisition": true,

  "javascript.validate.enable": true,
  "javascript.suggest.enabled": true,
  "javascript.suggestionActions.enabled": true,
  "javascript.suggest.autoImports": true,
  "javascript.suggest.paths": true,
  "javascript.format.enabled": true,

  "list.source.symbols.excludes": ["**/node_modules/**"],
  "list.source.files.excludePatterns": ["**/node_modules/**"],

  "prettier.enable": true,
  "prettier.bracketSpacing": true,
  "prettier.formatterPriority": 1,
  "prettier.documentSelectors": ["**/*.hbs"],
  "prettier.parser": { "*.hbs": "html" },
  "prettier.ignorePath": ".prettierignore",

  "eslint.packageManager": "yarn",
  // "eslint.nodePath": ".yarn/sdks",
  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.alwaysShowStatus": true,
  "eslint.run": "onType",
  "eslint.autoFixOnSave": false,
  "eslint.options": {
    "cache": true,
    "cacheLocation": ".eslintcache"
  },
  "eslint.workingDirectories": [
    { "mode": "auto" }
  ],
  "eslint.ignoreUntitled": true,
  "eslint.filetypes": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "markdown",
    "json"
  ],

  "html.autoClosingTags": false,
  "html.format.wrapAttributes": false,
}
